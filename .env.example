# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Clave de servicio: SOLO servidor. Nunca prefijar con NEXT_PUBLIC_.
# Se usa unicamente para operaciones que no puede hacer el usuario
# (crear la barberia en el alta y enviar mails). Bypassea RLS.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email transaccional (Resend) - casilla generica de la aplicacion.
# Si RESEND_API_KEY esta vacio, el envio se omite y se registra un aviso.
#
# En desarrollo: EMAIL_FROM="Turno Fijo <onboarding@resend.dev>"
#   Sin dominio verificado, Resend solo entrega a la casilla del dueno de la
#   cuenta. Alcanza para probar el flujo con tu propio correo.
#
# En produccion: verificar el dominio en Resend (SPF + DKIM) y usar una
#   casilla propia, por ejemplo "Turno Fijo <turnos@tudominio.com>".
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Turno Fijo <onboarding@resend.dev>"
